hook_idmap.c uses RESOLVE_NO_SYMLINKS without including fileutils.h (the
header carrying the ifndef fallback). glibc gets the constant via
sys/mount.h so upstream doesn't notice; musl doesn't. Not fixed upstream
as of 2.41.6; candidate for upstreaming (chimera is musl-only too) —
drop when it lands.

--- a/libmount/src/hook_idmap.c
+++ b/libmount/src/hook_idmap.c
@@ -21,6 +21,7 @@
 #include <sys/ioctl.h>
 #include <sys/mount.h>

+#include "fileutils.h"
 #include "strutils.h"
 #include "all-io.h"
 #include "namespace.h"
